# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma → local Supabase Postgres (started with `npm run db:start`).
# This is the default local Supabase DB connection — not a secret.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Gmail API (required to send inbox summaries by email).
# Generate OAuth credentials for Gmail API and a refresh token for the sender account.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
# Optional: defaults to the connected recipient email if omitted.
GMAIL_SENDER_EMAIL=""

# Local Python agent API. Start from ../python-agents with:
# .venv/bin/python agent_api.py
AGENT_API_URL="http://127.0.0.1:8766"

# Demo mode for the frontend retrieval pipeline.
# Use "wtg" to bypass python-agents and insert deterministic WTG demo results.
DEMO_AGENT_MODE="off"

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Task {
    id        Int      @id @default(autoincrement())
    title     String
    done      Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([createdAt])
}

model InboxEntry {
    id               String         @id
    priority         String
    category         String
    title            String
    translatedFrom   String?
    date             DateTime
    source           String
    summary          String
    locationName     String?
    locationLng      Float?
    locationLat      Float?
    locationCountryId String?
    imageUrl         String?
    deadline         DateTime?
    amountRange      String?
    topics           Json?
    funder           String?
    criteria         Json?
    bkEligible       String?
    originalLanguage String?
    sender           String?
    originalText     String?
    agentMetadata    Json?
    phases           FundingPhase[]
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt

    @@index([category])
    @@index([priority])
    @@index([date])
}

model FundingPhase {
    id      String     @id @default(cuid())
    entryId String
    kind    String
    label   String
    date    DateTime
    order   Int
    entry   InboxEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

    @@index([entryId])
    @@index([date])
}

model UserProfile {
    id             String   @id
    username       String   @default("local-user")
    org            String
    department     String
    prompt         String
    newsSources    Json
    emailConnected Boolean  @default(false)
    emailAddress   String?
    outputFormat   Json
    fundingSources Json
    fundingCriteria Json
    urgency        Json
    wtgKeywords    Json?
    wtgNewsCategories Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([org, username])
}

model AgentSettings {
    id                   String   @id
    org                  String
    username             String
    scheduleEnabled      Boolean  @default(true)
    intervalDays         Int      @default(2)
    nextRunAt            DateTime @default(now())
    focusAreas           Json
    model                String   @default("qwen3:8b")
    newsMaxCandidates    Int      @default(10)
    fundingMaxCandidates Int      @default(12)
    includeGdelt         Boolean  @default(true)
    gdeltTimespan        String   @default("7d")
    emailScanEnabled     Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    @@unique([org, username])
    @@index([nextRunAt])
}

model AgentRun {
    id              String    @id @default(cuid())
    org             String
    username        String
    status          String
    trigger         String
    progress        Int       @default(0)
    currentStep     String
    startedAt       DateTime?
    finishedAt      DateTime?
    lastError       String?
    insertedNews    Int       @default(0)
    insertedFunding Int       @default(0)
    insertedReports Int       @default(0)
    events          Json
    configSnapshot  Json
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([org, username, createdAt])
    @@index([status])
}
